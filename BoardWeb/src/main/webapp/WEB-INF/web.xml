<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         id="WebApp_ID" version="3.1">

	<!-- 
		Servlet 3.0 의 신규 사항으로 선언이나 매핑 항목들을 web.xml에다 적을 필요는 없다고 한다.
		https://docs.oracle.com/middleware/1221/wls/WBAPP/configureservlet.htm#WBAPP707
		
		Spring 에서도 web.xml 설정 없이 가능하니 추후 시도해보자.
		(참조) https://offbyone.tistory.com/215
	-->
	<display-name>Spring Quick Start Board Web Example</display-name>

	<!-- 
		The context-param element contains the declaration of a web application's servlet context 
	 	initialization parameters.
	 -->
	<context-param>
		<param-name>contextConfigLocation</param-name>
		<param-value>classpath:applicationContext.xml</param-value>
	</context-param>
	
	<listener>
		<!-- 
			The listener-class element declares a class in the application must be registered as a web application 
 			listener bean. The value is the fully qualified classname of the listener class.
		 -->
		<listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>
	</listener>
	
	<filter>
		<filter-name>characterEncoding</filter-name>
		<filter-class>org.springframework.web.filter.CharacterEncodingFilter</filter-class>
		<init-param>
			<param-name>encoding</param-name>
			<param-value>UTF-8</param-value>
		</init-param>
	</filter>
	<filter-mapping>
		<filter-name>characterEncoding</filter-name>
		<url-pattern>*.do</url-pattern>
	</filter-mapping>

	<servlet>
		<servlet-name>action</servlet-name>
		<servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
		<init-param>
			<param-name>contextConfigLocation</param-name>
			<param-value>/WEB-INF/config/presentation-layer.xml</param-value>
		</init-param>
	</servlet>
	<servlet-mapping>
		<servlet-name>action</servlet-name>
		<url-pattern>*.do</url-pattern>
	</servlet-mapping>
</web-app>
