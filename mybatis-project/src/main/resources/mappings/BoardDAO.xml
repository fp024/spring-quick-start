<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- myBatis Generator 자동생성 메퍼 XML 을 책 예제에 맞게 수정 -->
<mapper namespace="org.fp024.mybatistest.board.impl.BoardDAO">
	<resultMap id="BaseResultMap" type="board">
		<id 	column="seq" 		jdbcType="DECIMAL" 		property="seq" />
		<result column="title" 		jdbcType="VARCHAR" 		property="title" />
		<result column="writer" 	jdbcType="VARCHAR" 		property="writer" />
		<result column="content" 	jdbcType="VARCHAR" 		property="content" />
		<result column="regdate" 	jdbcType="TIMESTAMP" 	property="regDate" />
		<result column="cnt" 		jdbcType="DECIMAL" 		property="cnt" />
	</resultMap>
	
	<sql id="allColumns">
		seq
     , title
     , writer
     , content
     , regdate
     , cnt
	</sql>
	
	<insert id="insertBoard" parameterType="board">
		INSERT INTO board (seq, title, writer, content )
		VALUES ( (SELECT NVL(MAX(seq), 0) + 1 FROM board)
			  , #{title}, #{writer}, #{content} )
	</insert>

	<delete id="deleteBoard" parameterType="java.lang.Integer">
		DELETE
		  FROM board
		 WHERE seq = #{seq}
	</delete>

	<update id="updateBoard" parameterType="board">
		UPDATE board
		   SET title = #{title}
		     , writer = #{writer}
		     , content = #{content}
		     , regdate = #{regDate}
		     , cnt = #{cnt}
		 WHERE seq = #{seq}
	</update>
	<select id="getBoard" parameterType="java.lang.Integer" resultMap="BaseResultMap">
		SELECT <include refid="allColumns" />
		  FROM BOARD
		 WHERE seq = #{seq}
	</select>
	<select id="getBoardList" resultMap="BaseResultMap">
		select <include refid="allColumns" />
		  FROM board
		 WHERE title LIKE '%' || #{searchKeyword} || '%'
		 ORDER BY seq DESC
	</select>
</mapper>