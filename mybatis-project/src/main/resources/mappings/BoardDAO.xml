<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- myBatis Generator 자동생성 메퍼 XML 을 책 예제에 맞게 수정 -->
<mapper namespace="org.fp024.mybatistest.board.impl.BoardDAO">
  <sql id="allColumns">
    seq
    , title
     , writer
     , content
     , regdate
     , cnt
  </sql>

  <select id="getBoardList" resultMap="org.fp024.mybatistest.board.impl.generated.BoardDAO.BaseResultMap">
    SELECT
    <include refid="allColumns"/>
    FROM board
    WHERE title LIKE '%' || #{searchKeyword} || '%'
    ORDER BY seq DESC
  </select>
</mapper>